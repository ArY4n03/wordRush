# Optional: Self-hosted PeerJS signaling server (omit to use public PeerJS cloud)
# VITE_PEER_HOST=signal.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/myapp
# VITE_PEER_SECURE=true
# VITE_PEER_KEY=peerjs

# Optional: TURN relay server for restrictive NATs/firewalls
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=wordrush
# VITE_TURN_CREDENTIAL=secret

# Optional: Custom HTTP RoomDiscovery service URL
# VITE_DISCOVERY_URL=https://rooms.example.com
